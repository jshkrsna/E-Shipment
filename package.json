{
  "name": "e-shipmennt",
  "version": "1.0.0",
  "private": true,
  "description": "E-Shipmennt: pelacakan paket berbasis bukti dan penanganan sengketa",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production.local scripts/migrate.ts",
    "db:seed:prod": "tsx --env-file=.env.production.local scripts/seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-local.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@supabase/storage-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
