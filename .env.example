# ── Database ─────────────────────────────────────────────
# Kosongkan untuk memakai PGlite lokal (.data/pglite), tanpa instal Postgres.
# Produksi: connection string Postgres (Supabase pooler port 6543 / Neon).
DATABASE_URL=

# ── Sesi ────────────────────────────────────────────────
# String acak minimal 32 karakter (dipakai untuk token tautan & tanda tangan).
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ── Akun admin awal (dibuat oleh seed) ──────────────────
ADMIN_EMAIL=admin@eshipmennt.test
ADMIN_PASSWORD=admin12345

# ── Storage berkas bukti ────────────────────────────────
# local    : simpan di .data/uploads (pengembangan)
# supabase : Supabase Storage (produksi, wajib di Vercel)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence

# ── Google Drive Picker (opsional) ──────────────────────
# Ketiganya dari project Google Cloud yang SAMA. Kosongkan bila tidak dipakai.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=       # OAuth client (Web application), berakhiran .apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=         # API key, dibatasi ke Google Picker API
NEXT_PUBLIC_GOOGLE_APP_ID=          # Project number (angka), IAM & Admin > Settings
